name = "lengbanlist-stats"
main = "src/index.js"
compatibility_date = "2024-01-01"

# KV 命名空间绑定。绑定名必须是 STATS_KV，代码里按这个名字取（worker/src/index.js）
# 部署前：
#   1) cp wrangler.toml.example wrangler.toml   （wrangler.toml 已在 .gitignore，含 id 不入库）
#   2) npx wrangler kv namespace create STATS_KV
#   3) 把输出里的 id 填到下面
[[kv_namespaces]]
binding = "STATS_KV"
id = "REPLACE_WITH_YOUR_KV_ID"
